{
  "name": "echo-memory",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "description": "回声记忆 - 面向 AI Agent 的本地优先个人记忆操作系统（Tauri 2 + React + TS + Vite）",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:mcp": "cargo build --manifest-path src-tauri/Cargo.toml --release --bin echo-memory-mcp --features mcp-bin && install -m 755 src-tauri/target/release/echo-memory-mcp src-tauri/resources/echo-memory-mcp",
    "build:bundle": "npm run build && npm run build:mcp",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "check:test-env": "bash scripts/check-env.sh",
    "test:env": "bash scripts/run-env-tests.sh",
    "test:growth": "node --experimental-strip-types --test tests/growth-timeline.test.ts",
    "test:ui": "vitest run"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "jsdom": "^30.0.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^4.1.11"
  }
}
