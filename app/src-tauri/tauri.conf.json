{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "回声记忆",
  "version": "0.5.0",
  "identifier": "com.echomemory.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:bundle"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "回声记忆",
        "width": 1100,
        "height": 760,
        "minWidth": 860,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/Library/Application Support/回声记忆/audio/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "resources": {
      "resources/": ""
    }
  }
}
